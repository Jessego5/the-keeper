# Copy to backend/.env and paste your OpenAI key. .env is gitignored.
OPENAI_API_KEY=

# Optional — also deliver proactive lines to your phone via Telegram.
# Leave blank to keep just web + native banners. To enable:
#   1. Message @BotFather on Telegram, send /newbot, copy the token below.
#   2. Message your new bot once, then open
#      https://api.telegram.org/bot<TOKEN>/getUpdates to find your numeric chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
