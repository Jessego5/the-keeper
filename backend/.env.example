# Copy to backend/.env and paste your OpenAI key. .env is gitignored.
OPENAI_API_KEY=

# Feeds the Keeper watches for things worth telling you about. Comma-separated.
# It only speaks about an item that connects to something it already keeps about
# you. Unset means sources are off entirely.
KEEPER_FEEDS=

# --- Browser-closed delivery ---------------------------------------------- #
# The native macOS banner needs nothing here, but it is macOS-only and cannot
# fire from inside the container. These two work on any platform, and are the
# only surfaces that reach you when the Keeper runs in Docker.

# Discord — quickest to set up, no bot registration:
#   Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL
DISCORD_WEBHOOK_URL=

# Telegram — reaches your phone:
#   1. Message @BotFather, send /newbot, copy the token below.
#   2. Message your new bot once, then open
#      https://api.telegram.org/bot<TOKEN>/getUpdates and read the numeric chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
