# Copy to backend/.env and paste your OpenAI key. .env is gitignored.
OPENAI_API_KEY=

# Feeds the Keeper watches for things worth telling you about. Comma-separated.
# It only speaks about an item that connects to something it already keeps about
# you. Unset means sources are off entirely.
KEEPER_FEEDS=

# --- Browser-closed delivery ---------------------------------------------- #
# The native macOS banner needs nothing here, but it is macOS-only and cannot
# fire from inside the container. These two work on any platform, and are the
# only surfaces that reach you when the Keeper runs in Docker.

# Discord: quickest to set up, no bot registration:
#   Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL
DISCORD_WEBHOOK_URL=

# Telegram: reaches your phone, and is the way back in. Once set, you can talk to
# the Keeper there (its own thread, shared memory), approve or decline what it
# proposes with a tap, and turn the dial with /off /quiet /usual /eager. Only
# messages from TELEGRAM_CHAT_ID are heard. KEEPER_TELEGRAM_INBOX=0 makes it
# send-only again.
#   1. Message @BotFather, send /newbot, copy the token below.
#   2. Message your new bot once, then open
#      https://api.telegram.org/bot<TOKEN>/getUpdates and read the numeric chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Peer agents the Keeper may consult at non-public addresses. Public URLs work
# without this; loopback and LAN addresses are refused by default, because
# consult_peer follows a URL the model picked out of the conversation and a web
# page it reads can name one. Comma-separated origins, e.g. the demo's own
# loopback peer:
#   KEEPER_A2A_ALLOW=http://localhost:8790
KEEPER_A2A_ALLOW=

# Shared secret for the A2A endpoint. /a2a answers as the Keeper, and answering
# means recalling memory, so without this any local process can ask it what it
# knows about you. The endpoint is CLOSED until this is set. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
KEEPER_A2A_TOKEN=

# --- Gmail and Calendar (optional) ---------------------------------------- #
# Lets the Keeper read your mail and calendar, and PROPOSE sending an email or
# changing an event. Nothing is sent or changed until you approve the exact text,
# on the page or from Telegram. Setup, once:
#   1. console.cloud.google.com -> new project -> enable "Gmail API" and
#      "Google Calendar API".
#   2. OAuth consent screen: External, Testing, add yourself as a test user.
#   3. Credentials -> Create credentials -> OAuth client ID -> Desktop app. Copy
#      the id and secret below.
#   4. Make sure mcp.json has the "google" server from mcp.example.json. It
#      stays off until the three values below are set.
#   5. .venv/bin/python scripts/google_auth.py   (opens the consent page once;
#      the token is kept in ~/.google_workspace_mcp, outside this repo)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# The one account it acts as. Fixed by config, never chosen by the model.
KEEPER_GOOGLE_EMAIL=
